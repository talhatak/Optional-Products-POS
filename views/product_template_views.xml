<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_optional_products" model="ir.ui.view">
        <field name="name">product.template.form.pos.optional.products</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']//group[@name='pos']" position="inside">
                <field name="pos_optional_products_ids"
                       widget="many2many_tags"
                       domain="[('available_in_pos', '=', True), ('sale_ok', '=', True), ('id', '!=', id)]"
                       options="{'no_create': True}"
                       placeholder="Suggest drinks, sides, or other extras"/>
            </xpath>
        </field>
    </record>
</odoo>
